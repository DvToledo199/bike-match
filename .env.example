# Copy this file to .env (repo root) and adjust the values for your machine.
# .env is gitignored: never commit real credentials.
# Use plain KEY=value entries (no shell 'export' and no surrounding quotes).
# The defaults below are for local development only, never for deployment.

# --- PostgreSQL (used by docker-compose and by the backend) ---
POSTGRES_DB=bikematch
POSTGRES_USER=bikematch
POSTGRES_PASSWORD=bikematch

# --- Backend datasource (host/port where the backend finds PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
SERVER_ADDRESS=127.0.0.1

# --- CORS (frontend dev origin allowed by the backend) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (generate a private key with: openssl rand -base64 32) ---
JWT_SECRET_BASE64=
JWT_EXPIRATION=PT8H

# --- Optional first moderator ---
# Leave all three blank to disable it. Use a BCrypt hash, never a plain password.
INITIAL_MODERATOR_EMAIL=
INITIAL_MODERATOR_USERNAME=
INITIAL_MODERATOR_PASSWORD_HASH=

# --- Optional first administrator ---
# Same rules as the moderator: leave all three blank to disable it.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD_HASH=

# --- Cloudinary (copy the complete CLOUDINARY_URL from the dashboard) ---
CLOUDINARY_URL=

# --- Optional interpretation provider ---
# rules (default) needs nothing external. google-genai asks Gemini through Spring AI and
# needs GEMINI_API_KEY and GEMINI_MODEL; any other value stops the backend at startup.
INTERPRETATION_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=
# Whole call, single attempt; keep it below the browser's 75-second wait.
GEMINI_TIMEOUT=PT60S
INTERPRETATION_GENERATION_COOLDOWN=PT30S
